# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# =========================================================================
# CONFIGURAÇÃO DE EMAILS NO VERCEL (100% Opcional - sem mexer no código!)
# =========================================================================
# Opção 1: Resend (Recomendado - 3.000 emails grátis/mês em resend.com)
# Obtenha uma chave gratuita em: https://resend.com/api-keys
RESEND_API_KEY=

# (Opcional) Remetente do email. Se não colocar nada, usa o domínio de teste do Resend:
# EMAIL_FROM="Avisos ESJF <notificacoes@o-seu-dominio.com>"
EMAIL_FROM=

# (Opcional) Seu email pessoal para receber um aviso sempre que alguém subscrever:
ADMIN_EMAIL=

# (Opcional) ID da lista de audiência no Resend para guardar a lista de contactos:
RESEND_AUDIENCE_ID=

# Opção 2: Webhook alternativo (Make.com, Zapier, Google Sheets, Discord Webhook, Formspree, etc.)
# Se preenchido, recebe um POST com { email, subscribedAt, source }
EMAIL_WEBHOOK_URL=

# =========================================================================
# CONFIGURAÇÃO DE CRON / NOTIFICAÇÕES AUTOMÁTICAS (Vercel Cron - 1x por hora)
# =========================================================================
# (Obrigatório para segurança) Protege o endpoint /api/cron e assina links de cancelamento.
# Gere com: openssl rand -hex 16  →  cole o mesmo valor em CRON_SECRET e UNSUBSCRIBE_SECRET
# O cron do Vercel deve enviar Authorization: Bearer <CRON_SECRET> ou ?secret=<CRON_SECRET>
CRON_SECRET=
UNSUBSCRIBE_SECRET=

# APP_URL: URL pública do teu deploy (usada para gerar links de cancelamento nos emails)
# Ex: APP_URL=https://avisos-esjf.vercel.app  (Vercel injeta VERCEL_URL auto se vazio)
APP_URL=https://avisos-esjf.vercel.app

# (Opcional) Webhook do Discord para receber notificações automáticas de novos avisos
DISCORD_WEBHOOK_URL=

# (Opcional) Se "true", o cron envia um email resumo ao ADMIN_EMAIL a cada execução
# Por defeito é "false" para evitar spam. Ative apenas se quiser monitorizar.
CRON_NOTIFY_ADMIN=false

# =========================================================================
# WEB PUSH (Notificações nativas mesmo com o browser fechado - Chrome/Android)
# =========================================================================
# Gere com: npx web-push generate-vapid-keys
# No Vercel, adicione estas 3 vars. O public key é exposto em /api/push/vapid
VAPID_PUBLIC_KEY=BO_7W_BmaD6kRe6cecAwhD4_qVxkWitkIHG31QgzV7KA-FzAF2NR8q2-yMlBpRdrNlR75Aqw5f1cybNyxgffu4c
VAPID_PRIVATE_KEY=LzrremCjOaaQbqgZtETnxU6Sr4wJpoArnG9-o3nU1lc
VAPID_SUBJECT=mailto:avisos@esjf.edu.pt

# =========================================================================
# TELEGRAM (Notificações instantâneas no Telegram)
# =========================================================================
# 1. Fale com @BotFather no Telegram → /newbot → copie o token
# 2. Crie um canal/grupo → adicione o bot como admin → envie uma msg → use @getidsbot para saber o chat_id
# 3. Cole ambos no Vercel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =========================================================================
# PERSISTÊNCIA OPCIONAL (evita duplicados no cron após cold start)
# =========================================================================
# Se usar Upstash Redis (Vercel Marketplace → Upstash Redis → Add), estas vars são injetadas auto:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Sem isto, o cron usa memória + /tmp (pode repetir notificações após redeploy).

# =========================================================================
# WHATSAPP (Opções)
# =========================================================================
# - Twilio WhatsApp API (recomendado): TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_WHATSAPP_FROM, WHATSAPP_TO
# - Ou use o EMAIL_WEBHOOK_URL apontando para Make.com/Zapier que encaminha para WhatsApp Business
# Por agora, Telegram já cobre o caso de uso instantâneo; WhatsApp requer aprovação Meta/Twilio.

